{
  "name": "wbtv-desktop",
  "version": "0.1.0",
  "description": "WBTV desktop client: your WBTV server's channels in a window",
  "main": "main.js",
  "private": true,
  "homepage": "https://github.com/WB2024/WBTV",
  "author": "WB2024",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wb2024.wbtv",
    "productName": "WBTV",
    "icon": "build/icon.png",
    "files": ["main.js", "preload.js", "connect.html", "package.json"],
    "artifactName": "WBTV-Desktop-${version}-${os}.${ext}",
    "win": { "target": ["portable", "nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo", "maintainer": "WB2024" }
  }
}
